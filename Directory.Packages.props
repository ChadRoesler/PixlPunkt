<Project ToolsVersion="15.0">
  <!--
    To update the version of Uno, you should instead update the Sdk version in the global.json file.

    See https://aka.platform.uno/using-uno-sdk for more information.
    See https://aka.platform.uno/using-uno-sdk#implicit-packages for more information regarding the Implicit Packages.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- xUnit packages -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- PixlPunkt Dependencies -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- FluentIcons.WinUI 2.2.330+ depends on the Windows App SDK 1.8 split packages (Microsoft.WindowsAppSDK.WinUI);
         Uno.Sdk 6.5.x still references the 1.7 meta package. Mixing them breaks the MSIX build tasks. Keep the pair on 2.1.x until Uno moves to 1.8. -->
    <PackageVersion Include="FluentIcons.Common" Version="2.1.329" />
    <PackageVersion Include="FluentIcons.WinUI" Version="2.1.329" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
    <!-- FFmpeg for cross-platform media handling -->
    <PackageVersion Include="FFMpegCore" Version="5.4.0" />
    <!-- Bundled FFmpeg binaries - auto-downloads on first use -->
    <PackageVersion Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
    <!-- Cross-platform audio playback -->
    <PackageVersion Include="NetCoreAudio" Version="2.0.1" />
    <!-- Velopack for auto-updates on Windows Desktop -->
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <!--
      Transitive pins (see CentralPackageTransitivePinningEnabled in Directory.Build.props).
      Kiota.Abstractions comes via the HttpKiota UnoFeature: GHSA-7j59-v9qr-6fq9, patched in 1.22.0.
      Tmds.DBus.Protocol comes via Uno.WinUI.Runtime.Skia.X11: GHSA-xrw6-gwf8-vvr9, patched in 0.21.3.
    -->
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
</Project>