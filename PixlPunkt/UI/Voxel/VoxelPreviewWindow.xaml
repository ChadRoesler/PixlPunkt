<!--
═══════════════════════════════════════════════════════════════════════════════
  VOXEL PREVIEW WINDOW
═══════════════════════════════════════════════════════════════════════════════
  Renders a 3D voxel preview from tile face selections.
  
  Layout:
    Left panel:  Tile face pickers (3 or 6 faces) + mode toggle + export
    Right panel: 3D viewport (drag to rotate, scroll to zoom) + preset buttons
═══════════════════════════════════════════════════════════════════════════════
-->
<Window
    x:Class="PixlPunkt.UI.Voxel.VoxelPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:PixlPunkt.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Voxel Preview">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <!-- Left: Controls -->
            <ColumnDefinition Width="260"/>
            <!-- Right: Viewport -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LEFT PANEL: TILE PICKERS + CONTROLS                           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <!-- Face Mode Toggle -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Face Mode"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>
                        <ComboBox x:Name="FaceModeCombo"
                                  Width="220"
                                  SelectedIndex="0"
                                  SelectionChanged="FaceModeCombo_SelectionChanged">
                            <ComboBoxItem Content="3 Faces (mirrored)"/>
                            <ComboBoxItem Content="6 Faces (individual)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Color Linking -->
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="ColorLinkingCheckBox"
                                  Content="Color Linking"
                                  IsChecked="False"
                                  Checked="ColorLinking_Changed"
                                  Unchecked="ColorLinking_Changed"/>
                        <StackPanel x:Name="ColorTolerancePanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <TextBlock Text="Tolerance" FontSize="12" VerticalAlignment="Center"/>
                            <NumberBox x:Name="ColorToleranceBox"
                                       Width="80"
                                       Minimum="0"
                                       Maximum="255"
                                       Value="32"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="ColorTolerance_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <MenuFlyoutSeparator/>
                    <!-- 3-face mode: Front, Side, Top -->
                    <StackPanel x:Name="ThreeFacePanel" Spacing="8">
                        <TextBlock Text="Tile Faces"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Front / Back" FontSize="12"/>
                            <ComboBox x:Name="FrontTilePicker" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Left / Right" FontSize="12"/>
                            <ComboBox x:Name="SideTilePicker" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Top / Bottom" FontSize="12"/>
                            <ComboBox x:Name="TopTilePicker" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- 6-face mode: All individual -->
                    <StackPanel x:Name="SixFacePanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Tile Faces"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Front" FontSize="12"/>
                            <ComboBox x:Name="FrontTilePicker6" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Back" FontSize="12"/>
                            <ComboBox x:Name="BackTilePicker6" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Left" FontSize="12"/>
                            <ComboBox x:Name="LeftTilePicker6" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Right" FontSize="12"/>
                            <ComboBox x:Name="RightTilePicker6" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Top" FontSize="12"/>
                            <ComboBox x:Name="TopTilePicker6" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Bottom" FontSize="12"/>
                            <ComboBox x:Name="BottomTilePicker6" Width="220"
                                      SelectionChanged="TilePicker_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <MenuFlyoutSeparator/>

                    <!-- OUTLINE -->
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="OutlineCheckBox"
                                  Content="Outline"
                                  IsChecked="False"
                                  Checked="OutlineCheckBox_Changed"
                                  Unchecked="OutlineCheckBox_Changed"/>
                        <StackPanel x:Name="OutlineColorPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <TextBlock Text="Color" FontSize="12" VerticalAlignment="Center"/>
                            <ctrl:ColorSwatchButton x:Name="OutlineColorSwatch"
                                                    ColorChanged="OutlineColor_Changed"/>
                            <TextBlock Text="Size" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <NumberBox x:Name="OutlineSizeBox"
                                       Width="70"
                                       Minimum="1"
                                       Maximum="16"
                                       Value="1"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="OutlineSize_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PIXEL PREVIEW -->
                    <CheckBox x:Name="PixelPreviewCheckBox"
                              Content="Pixel Preview"
                              IsChecked="False"
                              Checked="PixelPreview_Changed"
                              Unchecked="PixelPreview_Changed"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Pixel Base" FontSize="12" VerticalAlignment="Center"/>
                        <NumberBox x:Name="PixelBaseSizeBox"
                                   Width="80"
                                   Minimum="1"
                                   Maximum="256"
                                   Value="16"
                                   SpinButtonPlacementMode="Inline"
                                   ValueChanged="PixelBaseSize_Changed"/>
                    </StackPanel>

                    <CheckBox x:Name="BackdropGridCheckBox"
                              Content="Backdrop Grid"
                              IsChecked="True"
                              Checked="BackdropGrid_Changed"
                              Unchecked="BackdropGrid_Changed"/>

                    <MenuFlyoutSeparator/>

                    <!-- FACE PAINTER (PHASE 1 FOUNDATION) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Face Painter"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>

                        <CheckBox x:Name="FacePainterCheckBox"
                                  Content="Enable Face Painter"
                                  IsChecked="False"
                                  Checked="FacePainter_Changed"
                                  Unchecked="FacePainter_Changed"/>

                        <StackPanel x:Name="FacePainterPanel"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Mode" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox x:Name="FacePainterModeCombo"
                                          Width="150"
                                          SelectedIndex="0"
                                          SelectionChanged="FacePainterMode_Changed">
                                    <ComboBoxItem Content="Paint"/>
                                    <ComboBoxItem Content="Sample"/>
                                    <ComboBoxItem Content="Erase Override"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock x:Name="FacePainterStatusText"
                                       FontSize="11"
                                       Opacity="0.85"
                                       TextWrapping="Wrap"
                                       Text="LMB apply mode using main FG color. RMB drag rotates camera."/>

                            <Button x:Name="ClearFaceOverridesButton"
                                    Content="Clear Face Overrides"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    Click="ClearFaceOverridesButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <MenuFlyoutSeparator/>

                    <!-- BUILD + EXPORT -->
                    <Button x:Name="BuildButton"
                            Content="Build Voxel"
                            Width="220"
                            HorizontalAlignment="Left"
                            Click="BuildButton_Click"/>

                    <Button x:Name="ExportButton"
                            Content="Export Image…"
                            Width="220"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="ExportButton_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RIGHT PANEL: 3D VIEWPORT                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Preset buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Viewport -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Preset View Buttons -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="4"
                        Padding="8,6"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                <Button Content="S"  Click="Preset_Click" Tag="south"     Padding="8,4" ToolTipService.ToolTip="South Isometric"/>
                <Button Content="SW" Click="Preset_Click" Tag="southwest" Padding="8,4" ToolTipService.ToolTip="Southwest Isometric"/>
                <Button Content="W"  Click="Preset_Click" Tag="west"      Padding="8,4" ToolTipService.ToolTip="West Isometric"/>
                <Button Content="NW" Click="Preset_Click" Tag="northwest" Padding="8,4" ToolTipService.ToolTip="Northwest Isometric"/>
                <AppBarSeparator/>
                <Button Content="Front"  Click="Preset_Click" Tag="front"  Padding="8,4"/>
                <Button Content="Back"   Click="Preset_Click" Tag="back"   Padding="8,4"/>
                <Button Content="Left"   Click="Preset_Click" Tag="left"   Padding="8,4"/>
                <Button Content="Right"  Click="Preset_Click" Tag="right"  Padding="8,4"/>
                <Button Content="Top"    Click="Preset_Click" Tag="top"    Padding="8,4"/>
                <Button Content="Bottom" Click="Preset_Click" Tag="bottom" Padding="8,4"/>
                <AppBarSeparator/>
                <Button Content="Reset"  Click="Reset_Click"  Padding="8,4"/>
                <AppBarSeparator/>
                <TextBlock x:Name="CameraStatsText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.85"
                           Text="pitch 0°  yaw 0°  zoom 100%"/>
            </StackPanel>

            <!-- Viewport Image -->
            <Border x:Name="ViewportHost"
                    Grid.Row="1"
                    Background="#FF1E1E1E"
                    Margin="0"
                    PointerPressed="Viewport_PointerPressed"
                    PointerMoved="Viewport_PointerMoved"
                    PointerReleased="Viewport_PointerReleased"
                    PointerWheelChanged="Viewport_PointerWheelChanged">
                <Image x:Name="ViewportImage"
                       Stretch="Uniform"/>
            </Border>
        </Grid>
    </Grid>
</Window>
