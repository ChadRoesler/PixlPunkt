<ContentDialog
    x:Class="PixlPunkt.UI.Dialogs.NewVolumetricDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New Volumetric Project"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="400">
        <TextBox x:Name="ProjectName" Header="Project Name" PlaceholderText="MyModel" TextChanged="Input_Changed"/>

        <!-- Shared by every kind of volumetric project -->
        <TextBlock Text="Tile Size (px)" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <NumberBox x:Name="TileW" Minimum="2" Maximum="128" Value="16" Width="100"
                       SpinButtonPlacementMode="Hidden" ValueChanged="Size_Changed"/>
            <TextBlock Text="&#xD7;" VerticalAlignment="Center"/>
            <NumberBox x:Name="TileH" Minimum="2" Maximum="128" Value="16" Width="100"
                       SpinButtonPlacementMode="Hidden" ValueChanged="Size_Changed"/>
        </StackPanel>
        <TextBlock Text="The tile is the texture for one face, and for voxels it is also the model's resolution. A 16 by 16 tile builds a 16 cubed model."
                   Opacity="0.5" FontSize="11" TextWrapping="Wrap"/>

        <!-- Voxel-specific. A second kind would replace this section rather than add to it. -->
        <ComboBox x:Name="FaceModeCombo"
                  Header="Faces"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0"
                  SelectionChanged="FaceMode_Changed">
            <ComboBoxItem Content="3 faces, mirrored (front and back share a tile)"/>
            <ComboBoxItem Content="6 faces, each its own tile"/>
        </ComboBox>

        <ComboBox x:Name="LayoutCombo"
                  Header="Sheet layout"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="0"
                  SelectionChanged="Layout_Changed">
            <ComboBoxItem Content="Cross (faces touch along their seams)"/>
            <ComboBoxItem Content="Compact (3 across, 2 down)"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Face sets" VerticalAlignment="Center"/>
            <NumberBox x:Name="SetCount" Minimum="1" Maximum="32" Value="1" Width="100"
                       SpinButtonPlacementMode="Hidden" ValueChanged="Size_Changed"/>
            <TextBlock Text="one set of tiles per model" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <TextBlock x:Name="SummaryText" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>

        <TextBlock Text="The project starts with no model. Paint the faces, then build from them in the voxel workspace."
                   Opacity="0.5" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
