<Window
    x:Class="PixlPunkt.UI.Font.FontPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="Font Preview">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SampleBox"
                     Grid.Column="0"
                     Header="Sample text"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="88"
                     TextChanged="Sample_Changed"/>

            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Bottom">
                <Button Content="Drawn only" Click="UseDrawn_Click" HorizontalAlignment="Stretch"
                        ToolTipService.ToolTip="Fill the sample with the characters that have been drawn, which is what there is to look at in a font still being built."/>
                <Button Content="Reset" Click="ResetSample_Click" HorizontalAlignment="Stretch"
                        ToolTipService.ToolTip="Put the standard sample back"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Size" VerticalAlignment="Center" Opacity="0.6"/>
            <ComboBox x:Name="SizeCombo" Width="150" SelectionChanged="Size_Changed"/>

            <TextBlock Text="Text" VerticalAlignment="Center" Opacity="0.6" Margin="8,0,0,0"/>
            <Button x:Name="ForegroundButton" Width="44" Height="30" Padding="0" CornerRadius="6"
                    ToolTipService.ToolTip="Colour the sample is drawn in">
                <Button.Flyout>
                    <Flyout>
                        <ColorPicker x:Name="ForegroundPicker"
                                     IsAlphaEnabled="False"
                                     IsColorSliderVisible="True"
                                     ColorChanged="Foreground_Changed"/>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <TextBlock Text="Behind" VerticalAlignment="Center" Opacity="0.6" Margin="8,0,0,0"/>
            <Button x:Name="BackgroundButton" Width="44" Height="30" Padding="0" CornerRadius="6"
                    ToolTipService.ToolTip="Colour behind the sample">
                <Button.Flyout>
                    <Flyout>
                        <ColorPicker x:Name="BackgroundPicker"
                                     IsAlphaEnabled="False"
                                     IsColorSliderVisible="True"
                                     ColorChanged="Background_Changed"/>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <CheckBox x:Name="UseTextColour"
                      Content="Recolour"
                      IsChecked="True"
                      Margin="8,0,0,0"
                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                      ToolTipService.ToolTip="Draw every glyph in the text colour. Clear this to see a font drawn in more than one colour as it is."/>

            <CheckBox x:Name="ShowBaselines"
                      Content="Baselines"
                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>

            <TextBlock Text="Zoom" VerticalAlignment="Center" Opacity="0.6" Margin="8,0,0,0"/>
            <Button Width="36" Height="30" Padding="0" CornerRadius="6" Click="ZoomOut_Click"
                    ToolTipService.ToolTip="Look closer. Does not change the size the font is rendered at.">
                <TextBlock Text="&#x2212;" FontSize="16"/>
            </Button>
            <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="34"
                       HorizontalTextAlignment="Center"/>
            <Button Width="36" Height="30" Padding="0" CornerRadius="6" Click="ZoomIn_Click"
                    ToolTipService.ToolTip="Look closer. Does not change the size the font is rendered at.">
                <TextBlock Text="+" FontSize="16"/>
            </Button>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="160">
            <Grid>
                <ScrollViewer x:Name="PreviewScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto"
                              ZoomMode="Disabled">
                    <Grid>
                        <skia:SKXamlCanvas x:Name="PreviewCanvas"
                                           PaintSurface="PreviewCanvas_PaintSurface"
                                           Loaded="PreviewCanvas_Loaded"
                                           SizeChanged="PreviewCanvas_SizeChanged"/>

                        <!-- A Skia canvas is not reliably hit-testable, so pointer input goes to a
                             transparent sibling stretched over it, as the tile panel does. -->
                        <Border x:Name="PreviewHitOverlay"
                                Background="Transparent"
                                PointerWheelChanged="Preview_PointerWheelChanged"
                                PointerPressed="Preview_PointerPressed"
                                PointerMoved="Preview_PointerMoved"
                                PointerReleased="Preview_PointerReleased"
                                PointerCaptureLost="Preview_PointerCaptureLost"/>
                    </Grid>
                </ScrollViewer>

                <!-- Says why the sample is empty, so a blank preview is never a mystery. -->
                <TextBlock x:Name="EmptyMessage"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Opacity="0.7"/>
            </Grid>
        </Border>

        <TextBlock x:Name="CrispnessText"
                   Grid.Row="3"
                   Opacity="0.6"
                   FontSize="12"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
